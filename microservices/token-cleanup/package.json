{
  "name": "token-cleanup-service",
  "version": "1.0.0",
  "description": "Token cleanup microservice for microservices starter",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "clean": "rm -rf dist",
    "prepare": "yarn build",
    "docker:build": "docker build -t token-cleanup-service .",
    "docker:run": "docker run --env-file .env token-cleanup-service",
    "docker:rebuild": "yarn docker:build && yarn docker:run",
    "lint": "eslint 'src/**/*.{ts,js}' --fix",
    "lint:check": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "type-check": "tsc --noEmit",
    "quality": "yarn type-check && yarn lint:check && yarn format:check"
  },
  "dependencies": {
    "@prisma/client": "6.14.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "prisma": "^6.14.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.4",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cleanup",
    "tokens",
    "microservice",
    "auth"
  ],
  "author": "Your Name",
  "license": "MIT"
}
