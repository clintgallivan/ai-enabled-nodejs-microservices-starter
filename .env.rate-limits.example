# =======================================================
# RATE LIMITING ENVIRONMENT VARIABLES
# =======================================================
# Add these to your .env files

# =======================================================
# DEVELOPMENT/STAGING VALUES (More lenient for testing)
# =======================================================
GENERAL_RATE_LIMIT="1000"
AUTH_RATE_LIMIT="50"
PASSWORD_RATE_LIMIT="10"
PUBLIC_RATE_LIMIT="100"
ADMIN_RATE_LIMIT="50"

GENERAL_RATE_LIMIT_WINDOW="15m"
AUTH_RATE_LIMIT_WINDOW="15m"
PASSWORD_RATE_LIMIT_WINDOW="1h"
PUBLIC_RATE_LIMIT_WINDOW="1m"
ADMIN_RATE_LIMIT_WINDOW="5m"

# =======================================================
# PRODUCTION VALUES (Stricter for security)
# =======================================================
# GENERAL_RATE_LIMIT="100"
# AUTH_RATE_LIMIT="5"
# PASSWORD_RATE_LIMIT="3"
# PUBLIC_RATE_LIMIT="20"
# ADMIN_RATE_LIMIT="10"

# GENERAL_RATE_LIMIT_WINDOW="15m"
# AUTH_RATE_LIMIT_WINDOW="15m"
# PASSWORD_RATE_LIMIT_WINDOW="1h"
# PUBLIC_RATE_LIMIT_WINDOW="1m"
# ADMIN_RATE_LIMIT_WINDOW="5m"

# =======================================================
# SUPPORTED TIME FORMATS (using ms library)
# =======================================================
# "30s" = 30 seconds
# "15m" = 15 minutes  
# "2h"  = 2 hours
# "1d"  = 1 day
# "1w"  = 1 week 