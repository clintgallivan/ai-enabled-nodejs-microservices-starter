{
  "name": "nodejs-microservices-starter",
  "version": "1.0.0",
  "description": "🚀 AI-Enhanced Node.js Microservices Starter | Railway Template Ready | Claude Code + Cursor Optimized | Complete Auth + JWT | Docker Native | TypeScript",
  "main": "dist/server.ts",
  "scripts": {
    "build": "npx tsc",
    "postbuild": "if [ \"$BUILD_NODE_ENV\" = \"development\" ]; then echo 'Running postbuild for development'; cp -r logs dist/; else echo 'Skipping postbuild'; fi",
    "start": "dotenv -e .env.production -- node dist/server.js",
    "dev": "dotenv -e .env.development -- ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "staging": "dotenv -e .env.staging -- ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "migrate:generate": "dotenv -e .env.development -- npx prisma migrate dev --create-only",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate deploy",
    "migrate:staging": "dotenv -e .env.staging -- npx prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:silent": "jest --silent",
    "test:verbose": "jest --verbose",
    "lint": "eslint 'src/**/*.{ts,js}' --fix",
    "lint:check": "eslint 'src/**/*.{ts,js}'",
    "format": "prettier --write 'src/**/*.{ts,js,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,js,json}'",
    "type-check": "tsc --noEmit",
    "quality": "yarn type-check && yarn lint:check && yarn format:check",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "microservices",
    "starter-template",
    "railway",
    "claude-code",
    "cursor-ai",
    "ai-enhanced",
    "jwt-auth",
    "prisma",
    "redis",
    "docker",
    "express",
    "postgresql",
    "production-ready",
    "authentication",
    "microservice-architecture",
    "ai-development",
    "claude",
    "cursor"
  ],
  "author": "",
  "license": "ISC",
  "_moduleAliases": {
    "controllers": "dist/controllers",
    "routes": "dist/routes",
    "middleware": "dist/middleware",
    "services": "dist/services",
    "utils": "dist/utils",
    "config": "dist/config"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "list": "^2.0.19",
    "module-alias": "^2.2.3",
    "ms": "^2.1.3",
    "pg": "^8.16.3",
    "prisma": "^6.12.0",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.6.1",
    "winston": "^3.17.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "concurrently": "^9.0.1",
    "dotenv-cli": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
