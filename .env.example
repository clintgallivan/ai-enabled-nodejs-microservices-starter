# ==================================================
# NODE.JS MICROSERVICES STARTER - ENVIRONMENT CONFIG
# ==================================================

# =============
# APP SETTINGS
# =============

# Application environment (production | development | staging)
NODE_ENV=development

# Server port
PORT=3000

# Allowed CORS origins (comma-separated)
# For development: include localhost ports for your frontend
# For production: include your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# =========
# SECRETS
# =========

# JWT signing secret - use a strong, random string
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-here

# Health endpoint secret - for internal health checks
# Generate with: openssl rand -base64 32, also can retreive from railway
# For Railway or other cloud providers, use their provided URL
HEALTH_SECRET=your-health-endpoint-secret-here

# Logs endpoint secret - for accessing application logs
# Generate with: openssl rand -base64 32
# For Railway or other cloud providers, use their provided URL
LOGS_SECRET=your-logs-endpoint-secret-here

# =================
# TOKEN EXPIRATION
# =================

# Refresh token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
REFRESH_TOKEN_EXPIRES_IN=7d

# Access token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
ACCESS_TOKEN_EXPIRES_IN=15m

# Health token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
HEALTH_TOKEN_EXPIRES_IN=1h

# Logs token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
LOGS_TOKEN_EXPIRES_IN=1h

# Password reset token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# Email verification token expiration (ms format: 1s, 1m, 1h, 1d, 1w)
EMAIL_VERIFY_TOKEN_EXPIRES_IN=24h

# =========
# DATABASE
# =========

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
# For local development with Docker:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp_dev
# For Railway or other cloud providers, use their provided URL
DATABASE_URL=postgresql://username:password@localhost:5432/myapp_dev

# =======
# REDIS
# =======

# Redis connection URL
# For local development: redis://localhost:6379
# For Railway or other cloud providers, use their provided URL
REDIS_URL=redis://localhost:6379

# =======================================================
# RATE LIMITING ENVIRONMENT VARIABLES
# =======================================================
# Refer to the rate-limits.env.example file and import those into your .env
# Note: They aren't shown here because we have dev and prod variant examples

# ===================
# DEVELOPMENT NOTES
# ===================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env files to version control
# 3. Use different values for each environment (dev/staging/prod)
# 4. Generate strong secrets using: openssl rand -base64 32
# 5. For Railway deployment, set these as environment variables in the dashboard 